{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "functions": {
    "api/chat.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/exam.ts": {
      "maxDuration": 60,
      "supportsCancellation": true
    },
    "api/auth.ts": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

# Loaded by `vite build` (Vercel and any other production build), never by
# `npm run dev`. These two values are public by design — the publishable key
# ships in the browser and row level security guards the tables — so they are
# committed here instead of living only in the Vercel dashboard.
#
# Without them the deployed site fell back to the file account store in
# server/auth.ts, which on Vercel sits in a per-instance /tmp folder: new
# accounts and sessions vanished on the next cold start, so signup and login
# looked broken. Variables set in the Vercel project still take precedence.
VITE_SUPABASE_URL=https://wckcbyobgpjwiolsdjjd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Fp6Ex9GyOLoQTu2vP51nKg_1PsvwBBQ

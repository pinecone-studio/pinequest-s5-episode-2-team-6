# LLM assistant — server-side only. Do not prefix these with VITE_.
# Copy this file to .env.local for local development, or set the same keys in
# the Vercel project's Environment Variables settings.

# Google Gemini (default when GEMINI_API_KEY is present)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

# OpenRouter
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-3.6-flash

# Any OpenAI-compatible server (Ollama, LM Studio, vLLM, ...)
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1

# Optional: requests per IP per minute. Defaults to 30.
# LLM_RATE_LIMIT=30

# Supabase (frontend client). Safe to expose as long as RLS is enabled on tables.
# These are public by design (the publishable key ships in the browser),
# so they are filled in for the whole team — they are NOT secrets.
VITE_SUPABASE_URL=https://wckcbyobgpjwiolsdjjd.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_Fp6Ex9GyOLoQTu2vP51nKg_1PsvwBBQ
